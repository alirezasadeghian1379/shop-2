NODE_ENV=production
PORT=62111
LISTEN_PORT=62162
API_BASE=https://example.com
HLS_DIR=/absolute/path/to/public/hls
FFMPEG_PATH=/usr/bin/ffmpeg

# Must equal WHATSAPP_BRIDGE_TOKEN in Laravel.
WHATSAPP_BRIDGE_TOKEN=
# Public Laravel webhook route, including WEBHOOK_SECRET_KEY.
WHATSAPP_WEBHOOK_URL=https://example.com/api/v1/whatsapp/webhook/CHANGE_ME
# Optional; defaults to websocket-server/storage/whatsapp-auth.
WHATSAPP_AUTH_DIR=
# Applied only to WhatsApp websocket and media requests.
WHATSAPP_PROXY_URL=http://192.168.200.2:10809
